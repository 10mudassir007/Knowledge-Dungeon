# Copy to .env and fill in the keys you use.
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS/Linux:       cp .env.example .env
# .env is gitignored - never commit real keys.

# LLM provider selection: groq | glm | gemini
LLM_PROVIDER=groq

# API keys for the selected provider (unused providers can stay empty).
GROQ_API_KEY=
GLM_API_KEY=
GEMINI_API_KEY=

# Optional. Without it the game still works: questions come from the model's
# own knowledge instead of Tavily search. GET /health reports whether it is set.
TAVILY_API_KEY=
